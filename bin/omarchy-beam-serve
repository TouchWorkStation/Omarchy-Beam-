#!/usr/bin/env python3
"""
omarchy-beam-serve — Beam Link: a short-lived LOCAL web page for the clipboard.

Serves the last N text entries from Omarchy's clipboard history (or just the
current clipboard) on a random port bound to this machine's LAN address, behind
an unguessable token in the URL. Your phone opens the link over your own Wi-Fi
and can copy any item. Nothing is uploaded to any cloud — the data stays on your
machine and travels only across your local network.

Safeguards:
  * binds to the LAN interface only, on an OS-assigned random port
  * an unguessable token must be in the URL path
  * the server shuts itself down after --ttl seconds
  * no request logging; clipboard contents are never written to logs or disk
  * every entry is HTML/JS-escaped before it reaches the page

This is invoked by `omarchy-beam --link`; it is not meant to be run by hand,
though it can be for testing.
"""

from __future__ import annotations  # keep annotations un-evaluated (py3.7+ safe)

import argparse
import html
import hmac
import json
import os
import signal
import socket
import socketserver
import subprocess
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


class BeamServer(ThreadingHTTPServer):
    """A ThreadingHTTPServer that does NOT do a reverse-DNS lookup at bind time.

    http.server's default server_bind() calls socket.getfqdn(host), which can
    block for many seconds on machines with slow or VPN-managed DNS (e.g.
    Tailscale/MagicDNS). That would hang startup before the URL is ever printed.
    We bind via the plain TCP server and set the name fields without any lookup.
    """

    daemon_threads = True
    allow_reuse_address = True

    def server_bind(self):
        socketserver.TCPServer.server_bind(self)
        host, port = self.server_address[:2]
        self.server_name = host
        self.server_port = port

STATE_HISTORY = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
    "omarchy", "clipboard-history.json",
)


def _is_cgnat(ip: str) -> bool:
    """100.64.0.0/10 — carrier-grade NAT, also the range Tailscale hands out.
    A phone on Wi-Fi (not on the tailnet) can't reach these, so they make a bad
    default for the QR URL."""
    try:
        a, b = (int(x) for x in ip.split(".")[:2])
        return a == 100 and 64 <= b <= 127
    except ValueError:
        return False


def _lan_rank(ip: str) -> int:
    """Prefer real LAN ranges over anything else."""
    if ip.startswith("192.168."):
        return 0
    if ip.startswith("10."):
        return 1
    if ip.startswith("172."):
        try:
            if 16 <= int(ip.split(".")[1]) <= 31:
                return 2
        except ValueError:
            pass
    return 9  # public or unknown — usable, but last resort


def _iface_ips() -> list[str]:
    """Global-scope IPv4 addresses from `ip addr` (if available)."""
    ips: list[str] = []
    try:
        out = subprocess.run(
            ["ip", "-4", "-o", "addr", "show", "scope", "global"],
            capture_output=True, text=True, timeout=2,
        ).stdout
        for line in out.splitlines():
            parts = line.split()
            for i, tok in enumerate(parts):
                if tok == "inet" and i + 1 < len(parts):
                    ips.append(parts[i + 1].split("/")[0])
    except (OSError, subprocess.SubprocessError):
        pass
    return ips


def lan_ip() -> str:
    """Best-effort LAN IP the phone should use to reach this host.

    Prefers a real private LAN address (192.168/10/172.16-31) and skips
    loopback, link-local, and Tailscale/CGNAT (100.64/10) — a common wrong
    pick on machines running a VPN. Override with BEAM_LINK_HOST / --host.
    """
    override = os.environ.get("BEAM_LINK_HOST")
    if override:
        return override.strip()

    candidates: list[str] = []
    # The source address the kernel would use for internet-bound traffic.
    for target in ("1.1.1.1", "8.8.8.8", "192.0.2.1"):
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            s.connect((target, 9))  # no packets sent; just selects a route/source
            candidates.append(s.getsockname()[0])
        except OSError:
            pass
        finally:
            s.close()
    candidates += _iface_ips()

    usable = [
        ip for ip in candidates
        if ip and not ip.startswith("127.")
        and not ip.startswith("169.254.")
        and not _is_cgnat(ip)
    ]
    if usable:
        usable.sort(key=_lan_rank)
        return usable[0]
    # Nothing but loopback/CGNAT — fall back to whatever we found.
    return next((ip for ip in candidates if ip), "127.0.0.1")


def current_clipboard() -> str:
    try:
        out = subprocess.run(
            ["wl-paste", "--no-newline"],
            capture_output=True, timeout=2,
        )
        return out.stdout.decode("utf-8", "replace")
    except (OSError, subprocess.SubprocessError):
        return ""


def read_entries(count: int, current_only: bool) -> list[str]:
    """Return up to `count` recent text entries, newest first."""
    if current_only:
        text = current_clipboard()
        return [text] if text.strip() else []

    texts: list[str] = []
    try:
        with open(STATE_HISTORY, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        if isinstance(data, list):
            for entry in data:
                if (isinstance(entry, dict) and entry.get("type") == "text"
                        and str(entry.get("text", "")).strip()):
                    texts.append(str(entry["text"]))
    except (OSError, ValueError):
        texts = []

    if not texts:  # history disabled or empty — fall back to the live clipboard
        text = current_clipboard()
        if text.strip():
            texts = [text]

    return texts[: max(1, count)]


def render_page(entries: list[str]) -> bytes:
    # Embed the raw strings as a JS array (safely encoded) for the copy buttons,
    # and also render an escaped, selectable copy of each for manual fallback.
    payload = json.dumps(entries).replace("<", "\\u003c").replace("&", "\\u0026")

    items = []
    for i, text in enumerate(entries):
        safe = html.escape(text)
        items.append(
            f'<li class="item">'
            f'<pre class="text" onclick="selectText(this)">{safe}</pre>'
            f'<button class="copy" onclick="copyItem({i}, this)">Copy</button>'
            f'</li>'
        )
    body = "\n".join(items) if items else '<li class="empty">Nothing to beam.</li>'

    doc = f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>Beam</title>
<style>
  :root {{ color-scheme: dark; }}
  * {{ box-sizing: border-box; }}
  body {{ margin: 0; background: #101315; color: #cacccc;
    font: 16px/1.5 system-ui, -apple-system, sans-serif; padding: 16px; }}
  header {{ text-align: center; margin: 8px 0 20px; }}
  h1 {{ font-size: 14px; letter-spacing: 4px; font-weight: 700; margin: 0; }}
  .sub {{ font-size: 12px; color: #707880; margin-top: 4px; }}
  ul {{ list-style: none; margin: 0; padding: 0; display: flex;
    flex-direction: column; gap: 12px; }}
  .item {{ background: #181c1f; border: 1px solid #262b2f; border-radius: 12px;
    padding: 12px; }}
  .text {{ margin: 0 0 10px; white-space: pre-wrap; word-break: break-word;
    font-family: ui-monospace, monospace; font-size: 14px; max-height: 40vh;
    overflow: auto; }}
  .copy {{ width: 100%; padding: 12px; border: 0; border-radius: 10px;
    background: #cacccc; color: #101315; font-weight: 700; font-size: 15px; }}
  .copy:active {{ opacity: .7; }}
  .empty {{ text-align: center; color: #707880; }}
  footer {{ text-align: center; color: #707880; font-size: 11px; margin-top: 24px; }}
</style>
</head>
<body>
<header><h1>BEAM</h1><div class="sub">Tap Copy, or tap the text to select it</div></header>
<ul>{body}</ul>
<footer>Local link · closes itself shortly</footer>
<script>
const ENTRIES = {payload};
function selectText(el) {{
  const r = document.createRange(); r.selectNodeContents(el);
  const s = getSelection(); s.removeAllRanges(); s.addRange(r);
}}
async function copyItem(i, btn) {{
  const text = ENTRIES[i]; const done = () => {{ btn.textContent = "Copied ✓";
    setTimeout(() => btn.textContent = "Copy", 1200); }};
  try {{ await navigator.clipboard.writeText(text); done(); return; }} catch (e) {{}}
  const ta = document.createElement("textarea"); ta.value = text;
  ta.style.position = "fixed"; ta.style.opacity = "0"; document.body.appendChild(ta);
  ta.focus(); ta.select();
  try {{ document.execCommand("copy"); done(); }}
  catch (e) {{ btn.textContent = "Select the text above"; }}
  document.body.removeChild(ta);
}}
</script>
</body>
</html>"""
    return doc.encode("utf-8")


def make_handler(token: str, entries: list[str]):
    page = render_page(entries)
    token_path = "/" + token

    class Handler(BaseHTTPRequestHandler):
        server_version = "BeamLink"

        def log_message(self, *args):  # never log requests (privacy)
            pass

        def _deny(self):
            self.send_response(404)
            self.send_header("Content-Length", "0")
            self.end_headers()

        def do_GET(self):
            # Constant-time token check; the token is the only valid path.
            path = self.path.split("?", 1)[0].rstrip("/") or "/"
            if not hmac.compare_digest(path, token_path):
                self._deny()
                return
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(page)))
            self.send_header("Cache-Control", "no-store")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header(
                "Content-Security-Policy",
                "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'",
            )
            self.end_headers()
            self.wfile.write(page)

    return Handler


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument("--count", type=int, default=5, help="recent text entries to serve")
    ap.add_argument("--current", action="store_true", help="serve only the current clipboard")
    ap.add_argument("--ttl", type=int, default=180, help="seconds before auto-shutdown")
    ap.add_argument("--url-file", help="write the URL here once bound")
    ap.add_argument("--pid-file", help="write this process's PID here")
    ap.add_argument("--host", help="LAN IP to advertise in the URL (default: auto-detect)")
    args = ap.parse_args()

    entries = read_entries(args.count, args.current)

    import secrets
    token = secrets.token_urlsafe(18)
    ip = (args.host or lan_ip()).strip()
    # Listen on every interface so the phone can reach us regardless of which
    # address auto-detection chose; the URL still advertises the LAN IP above.
    httpd = BeamServer(("0.0.0.0", 0), make_handler(token, entries))
    port = httpd.server_address[1]
    url = f"http://{ip}:{port}/{token}"

    if args.pid_file:
        _write(args.pid_file, str(os.getpid()))
    if args.url_file:
        _write(args.url_file, url)
    print(url, flush=True)

    def shutdown(*_):
        threading.Thread(target=httpd.shutdown, daemon=True).start()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    if args.ttl > 0:
        threading.Timer(args.ttl, shutdown).start()

    try:
        httpd.serve_forever()
    finally:
        for f in (args.url_file, args.pid_file):
            if f:
                try:
                    os.unlink(f)
                except OSError:
                    pass
    return 0


def _write(path: str, value: str):
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as fh:
            fh.write(value)
    except OSError:
        pass


if __name__ == "__main__":
    sys.exit(main())
