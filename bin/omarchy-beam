#!/usr/bin/env bash
#
# omarchy-beam — Beam your clipboard to any device.
#
# Copy anything -> press a shortcut -> scan a QR code with your phone.
#
# Everything runs locally. In the default (QR) mode, clipboard contents never
# leave the machine except visually, through the QR code you scan: no accounts,
# no pairing, no cloud, no network requests, no logging of contents.
#
# The opt-in "Beam Link" mode (--link) is the one exception: it serves recent
# clipboard entries from a tiny web server on THIS machine, reachable over your
# own LAN via a tokened URL, so a phone can copy them. Still no cloud — the data
# stays on your machine/network — but it does travel over your Wi-Fi and exposes
# history to whoever holds the link, so it is never the default.
#
# Usage:
#   omarchy-beam              Toggle the Beam overlay for the current clipboard
#   echo "text" | omarchy-beam -   Beam piped text as a QR in the terminal
#   omarchy-beam --help
#   omarchy-beam --version
#
# Internal:
#   omarchy-beam --emit       Emit "meta" + QR module matrix for the QML overlay
#                             (reads the clipboard directly; called by Beam.qml)

set -uo pipefail

readonly BEAM_VERSION="0.3.3"
readonly PLUGIN_ID="beam"

# Maximum clipboard size we will turn into a QR code. Small pieces of info is
# the whole point; a wall of text produces a dense QR that phones struggle to
# scan. Override with BEAM_MAX_BYTES if you really need to.
MAX_BYTES="${BEAM_MAX_BYTES:-1200}"

# qrencode settings. Level M (~15% recovery) survives screen glare and camera
# noise far better than the default L, and the payload cap keeps the code from
# getting too dense. Margin 4 is the spec-required quiet zone.
readonly QR_LEVEL="M"
readonly QR_MARGIN="4"

# Prefer a UTF-8 locale so string length and truncation are multibyte-aware
# (an ellipsis or an accented character must count as one character, not
# several bytes). Falls back silently if the current locale is already UTF-8
# or none is available.
if [[ ! "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" =~ [Uu][Tt][Ff] ]]; then
  for _loc in C.UTF-8 C.utf8 en_US.UTF-8; do
    if locale -a 2>/dev/null | grep -qix "$_loc"; then export LC_ALL="$_loc"; break; fi
  done
  unset _loc
fi

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

die() {
  printf 'omarchy-beam: %s\n' "$*" >&2
  exit 1
}

have() { command -v "$1" >/dev/null 2>&1; }

# Percent-encode a string for use in a URI query (RFC 3986 unreserved set kept
# literal, everything else — including UTF-8 bytes and newlines — encoded).
# LC_ALL=C makes this iterate byte-by-byte, which is exactly what URI encoding
# of multibyte UTF-8 requires.
urlencode() {
  local LC_ALL=C str="$1" out="" i ch ord
  for (( i = 0; i < ${#str}; i++ )); do
    ch=${str:i:1}
    case $ch in
      [-_.~a-zA-Z0-9]) out+=$ch ;;
      *) printf -v ord '%d' "'$ch"; out+=$(printf '%%%02X' $(( ord & 255 ))) ;;
    esac
  done
  printf '%s' "$out"
}

# How plain text should be encoded so it's easy to grab on a phone:
#   plain  — a raw text QR (default; copy via Lens / a QR app / saved-photo)
#   sms    — sms:?body=…    the phone opens Messages with the text prefilled
#   mailto — mailto:?body=… the phone opens Mail with the text prefilled
# Set BEAM_TEXT_MODE, or write the value to
# ~/.config/omarchy-beam/text-mode (the env var wins). The config file is read
# so the overlay (which runs `omarchy-beam --emit` from the shell's own
# environment) honors the setting without needing it exported session-wide.
resolve_text_mode() {
  local m="${BEAM_TEXT_MODE:-}"
  if [[ -z "$m" ]]; then
    local f="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-beam/text-mode"
    [[ -r "$f" ]] && m="$(tr -d '[:space:]' <"$f" 2>/dev/null)"
  fi
  case "$m" in
    sms|mailto|plain) printf '%s' "$m" ;;
    *)                printf 'plain' ;;
  esac
}

# Notify the user without ever putting clipboard contents in the message.
notify() {
  local title="$1" body="$2"
  if have notify-send; then
    notify-send -a "Omarchy Beam" "$title" "$body" >/dev/null 2>&1 && return 0
  fi
  # Fallback so a bare terminal invocation still says something useful.
  printf '%s: %s\n' "$title" "$body" >&2
}

require_qrencode() {
  have qrencode || die "qrencode is not installed. Install it with: sudo pacman -S qrencode"
}

require_clipboard() {
  have wl-paste || die "wl-paste is not installed. Install it with: sudo pacman -S wl-clipboard"
}

# ---------------------------------------------------------------------------
# Beam Link — an opt-in, short-lived LOCAL web page for clipboard history
# ---------------------------------------------------------------------------
#
# `omarchy-beam --link [N]` starts omarchy-beam-serve (a tiny web server bound
# to this machine's LAN address) and shows a QR of its URL. A phone on the same
# Wi-Fi opens the link and can copy any of the last N clipboard entries. The
# server self-expires (TTL) and is stopped when the overlay closes. Data stays
# on your machine/LAN — nothing is uploaded to any cloud.

# Resolve the sibling helper (works from the plugin dir or a PATH symlink).
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
SERVE_BIN="${OMARCHY_BEAM_SERVE:-$SCRIPT_DIR/omarchy-beam-serve}"

LINK_DIR="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/omarchy-beam"
LINK_URL_FILE="$LINK_DIR/link.url"
LINK_PID_FILE="$LINK_DIR/link.pid"

link_server_alive() {
  local pid
  [[ -r "$LINK_PID_FILE" ]] || return 1
  pid="$(cat "$LINK_PID_FILE" 2>/dev/null)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

# A link is "active" only when both the URL is present and its server is running.
link_active() {
  [[ -s "$LINK_URL_FILE" ]] && link_server_alive
}

link_stop() {
  local pid
  if [[ -r "$LINK_PID_FILE" ]]; then
    pid="$(cat "$LINK_PID_FILE" 2>/dev/null)"
    [[ -n "$pid" ]] && kill "$pid" 2>/dev/null
  fi
  rm -f "$LINK_URL_FILE" "$LINK_PID_FILE" 2>/dev/null
  return 0
}

# Default entry count for --link when no argument and no picker (config file
# ~/.config/omarchy-beam/link-count, else 5).
resolve_link_count_default() {
  local f="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-beam/link-count" n=""
  [[ -r "$f" ]] && n="$(tr -dc '0-9' <"$f" 2>/dev/null)"
  [[ -n "$n" && "$n" -gt 0 ]] 2>/dev/null && printf '%s' "$n" || printf '5'
}

# Ask how many entries to share via the first available dmenu-style picker.
# Prints "current" or an integer. Returns non-zero if the user cancels a real
# picker; falls back to the default count when no picker is installed.
prompt_count() {
  local default menu choice picker found=""
  default="$(resolve_link_count_default)"
  menu=$'Current clipboard only\nLast 3\nLast 5\nLast 10\nLast 25\nAll history'
  for picker in "walker --dmenu" "fuzzel --dmenu" "wofi --dmenu -i" "tofi" "bemenu -p Beam:"; do
    if have "${picker%% *}"; then
      found=1
      choice="$(printf '%s' "$menu" | $picker 2>/dev/null)"
      break
    fi
  done
  if [[ -z "$found" ]]; then printf '%s' "$default"; return 0; fi
  [[ -n "$choice" ]] || return 1   # user cancelled the picker
  case "$choice" in
    Current*) printf 'current' ;;
    "Last 3") printf '3' ;;
    "Last 5") printf '5' ;;
    "Last 10") printf '10' ;;
    "Last 25") printf '25' ;;
    All*)      printf '500' ;;
    *)         printf '%s' "$default" ;;
  esac
}

# ---------------------------------------------------------------------------
# Clipboard reading (Wayland)
# ---------------------------------------------------------------------------

# Print 1 if the clipboard currently offers any text/* type, else 0. Images and
# other binary selections are deliberately treated as "nothing to beam".
clipboard_has_text() {
  local types
  types="$(wl-paste --list-types 2>/dev/null)" || { printf 0; return; }
  if grep -qiE '^text/' <<<"$types"; then printf 1; else printf 0; fi
}

# Read the clipboard as text, without wl-paste's appended trailing newline.
read_clipboard() {
  wl-paste --no-newline 2>/dev/null
}

# ---------------------------------------------------------------------------
# Content classification (deterministic, no AI, no network)
# ---------------------------------------------------------------------------
#
# Sets three globals from the raw content passed in:
#   BEAM_KIND    url | text | email | tel | wifi
#   BEAM_LABEL   the scan-action line ("Scan to open", ...)
#   BEAM_PAYLOAD the exact string that gets encoded into the QR

classify() {
  local content="$1"

  # BEAM_DISPLAY is the human-readable string for the preview; it equals the
  # payload for every kind except plain text in sms/mailto mode, where the
  # payload becomes a URI but the preview must still show the original text.
  BEAM_DISPLAY=""

  # Trim leading/trailing whitespace for prefix/pattern matching.
  local trimmed="$content"
  trimmed="${trimmed#"${trimmed%%[![:space:]]*}"}"
  trimmed="${trimmed%"${trimmed##*[![:space:]]}"}"

  local single_line=1
  [[ "$trimmed" == *$'\n'* ]] && single_line=0

  # Regexes are held in variables so the [[ =~ ]] parser treats bracket
  # expressions (which contain spaces and hyphens) as data, not syntax.
  local re_wifi='^WIFI:[A-Za-z]?:?.*;'
  local re_url='^https?://[^[:space:]]+$'
  local re_mailto='^mailto:[^[:space:]]+$'
  local re_email='^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$'
  local re_tel='^tel:[+0-9][-0-9(). ]*$'

  # Wi-Fi QR payload, e.g. WIFI:T:WPA;S:MyNet;P:secret;;
  if [[ "$trimmed" =~ $re_wifi ]]; then
    BEAM_KIND="wifi"; BEAM_LABEL="Scan to join"; BEAM_PAYLOAD="$trimmed"; return
  fi

  # URL (http / https)
  if (( single_line )) && [[ "$trimmed" =~ $re_url ]]; then
    BEAM_KIND="url"; BEAM_LABEL="Scan to open"; BEAM_PAYLOAD="$trimmed"; return
  fi

  # Email — explicit mailto:, or a bare address (rewritten to mailto: so the
  # phone offers to compose rather than just copy).
  if (( single_line )) && [[ "$trimmed" =~ $re_mailto ]]; then
    BEAM_KIND="email"; BEAM_LABEL="Scan to email"; BEAM_PAYLOAD="$trimmed"; return
  fi
  if (( single_line )) && [[ "$trimmed" =~ $re_email ]]; then
    BEAM_KIND="email"; BEAM_LABEL="Scan to email"; BEAM_PAYLOAD="mailto:${trimmed}"; return
  fi

  # Telephone
  if (( single_line )) && [[ "$trimmed" =~ $re_tel ]]; then
    BEAM_KIND="tel"; BEAM_LABEL="Scan to call"; BEAM_PAYLOAD="$trimmed"; return
  fi

  # Everything else is plain text. By default encode it verbatim (raw content)
  # so what the phone reads is exactly what was on the clipboard. In sms/mailto
  # mode, wrap it in a URI so a stock phone camera opens a prefilled draft the
  # user can copy from (nothing is sent, and no data leaves the machine).
  BEAM_KIND="text"; BEAM_LABEL="Scan to copy"; BEAM_DISPLAY="$content"
  case "$(resolve_text_mode)" in
    sms)    BEAM_PAYLOAD="sms:?body=$(urlencode "$content")" ;;
    mailto) BEAM_PAYLOAD="mailto:?body=$(urlencode "$content")" ;;
    *)      BEAM_PAYLOAD="$content" ;;
  esac
}

# Build a short, single-line, human preview for under the QR code. Never trusts
# the content to be safe to print raw: control characters are stripped and the
# result is truncated so it can never blow out the overlay layout.
preview_of() {
  local content="$1" kind="$2"
  local text

  case "$kind" in
    url)   text="${content#*://}" ; text="${text%/}" ;;      # drop scheme + trailing /
    email) text="${content#mailto:}" ;;
    tel)   text="${content#tel:}" ;;
    wifi)
      # Pull the SSID out of the WIFI: payload for a friendly label.
      if [[ "$content" =~ [Ss]:([^\;]*)\; ]]; then
        text="Wi-Fi: ${BASH_REMATCH[1]}"
      else
        text="Wi-Fi network"
      fi
      ;;
    *)     text="$content" ;;                                 # full text (wrapped by the overlay)
  esac

  # Replace tabs/newlines/other control chars with spaces, squeeze runs. Keeping
  # it single-line is required by the CLI↔QML protocol (the preview is one
  # tab-delimited field); the overlay wraps it across several lines for display.
  text="$(printf '%s' "$text" | tr '\t\r\n' '   ' | tr -s ' ')"
  text="${text#"${text%%[![:space:]]*}"}"
  text="${text%"${text##*[![:space:]]}"}"

  # Character-based truncation (UTF-8 aware under a UTF-8 locale). Plain text
  # gets a longer allowance so it is genuinely readable/copyable off the
  # overlay; the other kinds are short identifiers that stay on one line.
  local max=42
  [[ "$kind" == "text" ]] && max=180
  if (( ${#text} > max )); then
    text="${text:0:max-1}…"
  fi
  printf '%s' "$text"
}

# ---------------------------------------------------------------------------
# QR generation
# ---------------------------------------------------------------------------

# Emit a square 0/1 module matrix (one row per line) for the given payload on
# stdin. Mirrors how Omarchy's own omarchy-network-qr feeds the shell: qrencode
# ASCII uses two chars per module, so each pair collapses to a single 0/1.
# Payload is passed on stdin only — never interpolated into a command line.
qr_matrix() {
  local ascii
  ascii="$(qrencode --type ASCII --margin "$QR_MARGIN" --level "$QR_LEVEL" --output - 2>/dev/null)" || return 1
  [[ -n "$ascii" ]] || return 1
  local line row col
  while IFS= read -r line; do
    row=""
    for (( col = 0; col < ${#line}; col += 2 )); do
      if [[ "${line:col:2}" == *"#"* ]]; then row+="1"; else row+="0"; fi
    done
    printf '%s\n' "$row"
  done <<<"$ascii"
}

# ---------------------------------------------------------------------------
# Sub-commands
# ---------------------------------------------------------------------------

cmd_help() {
  cat <<'EOF'
Omarchy Beam — Beam your clipboard to any device.

  Copy → Super + Shift + Q → Scan

USAGE
  omarchy-beam                 Toggle the Beam overlay for the current clipboard
  omarchy-beam --link [N]      Beam Link: share the last N clipboard entries as a
                               local web page (QR to open on your phone). With no
                               N, a picker asks how many. Use 'current' for just
                               the current clipboard, 'all' for full history.
  echo "text" | omarchy-beam - Beam piped text as a QR in the terminal
  omarchy-beam --link-doctor   Diagnose Beam Link (prints the server's output)
  omarchy-beam --help          Show this help
  omarchy-beam --version       Show the version

The overlay classifies the clipboard automatically and shows the matching
action: Scan to open (URL), Scan to copy (text), Scan to email (mailto:),
Scan to call (tel:), or Scan to join (Wi-Fi QR). Press Esc or click outside
the card to close it.

PRIVACY
  Everything is local. Your clipboard never leaves this machine except
  visually, through the QR code. No accounts, no cloud, no network, no history.
EOF
}

cmd_version() { printf 'omarchy-beam %s\n' "$BEAM_VERSION"; }

# --emit: read the clipboard, classify, size-check, and print the protocol the
# QML overlay parses:  meta<TAB>status<TAB>kind<TAB>label<TAB>preview  then, for
# status "ok", the QR module matrix. status is one of ok|empty|toolarge.
cmd_emit() {
  require_qrencode

  # Beam Link mode: if a link server is running, show a QR of its URL instead
  # of the clipboard. No clipboard access is needed in this branch.
  if link_active; then
    local url host matrix
    url="$(cat "$LINK_URL_FILE" 2>/dev/null)"
    host="${url#http://}"; host="${host%%/*}"
    matrix="$(printf '%s' "$url" | qr_matrix)"
    if [[ -n "$matrix" ]]; then
      printf 'meta\t%s\t%s\t%s\t%s\n' "ok" "link" "Scan to open on your phone" "$host"
      printf '%s\n' "$matrix"
      return 0
    fi
  fi

  require_clipboard

  local status kind label preview
  if [[ "$(clipboard_has_text)" != "1" ]]; then
    printf 'meta\t%s\t%s\t%s\t%s\n' "empty" "" "Nothing to Beam" ""
    return 0
  fi

  local content
  content="$(read_clipboard)"

  # All-whitespace or empty is nothing to beam.
  if [[ -z "${content//[[:space:]]/}" ]]; then
    printf 'meta\t%s\t%s\t%s\t%s\n' "empty" "" "Nothing to Beam" ""
    return 0
  fi

  local bytes
  bytes="$(printf '%s' "$content" | wc -c)"
  if (( bytes > MAX_BYTES )); then
    printf 'meta\t%s\t%s\t%s\t%s\n' "toolarge" "" "Too large to Beam" \
      "$(human_size "$bytes") — limit $(human_size "$MAX_BYTES")"
    return 0
  fi

  classify "$content"
  preview="$(preview_of "${BEAM_DISPLAY:-$BEAM_PAYLOAD}" "$BEAM_KIND")"
  # Preview is the last field and must contain no tab/newline (sanitized above).

  local matrix
  matrix="$(printf '%s' "$BEAM_PAYLOAD" | qr_matrix)"
  if [[ -z "$matrix" ]]; then
    printf 'meta\t%s\t%s\t%s\t%s\n' "toolarge" "" "Too large to Beam" ""
    return 0
  fi

  printf 'meta\t%s\t%s\t%s\t%s\n' "ok" "$BEAM_KIND" "$BEAM_LABEL" "$preview"
  printf '%s\n' "$matrix"
}

human_size() {
  local b="$1"
  if (( b >= 1024 )); then
    awk -v b="$b" 'BEGIN { printf "%.1f KB", b/1024 }'
  else
    printf '%d B' "$b"
  fi
}

# Pipe mode: echo "text" | omarchy-beam -
# Renders the QR straight to the terminal without touching the clipboard or
# opening the overlay. Handy over SSH or in scripts.
cmd_pipe() {
  require_qrencode
  local content
  content="$(cat)"
  if [[ -z "${content//[[:space:]]/}" ]]; then
    die "nothing on stdin to beam"
  fi
  local bytes
  bytes="$(printf '%s' "$content" | wc -c)"
  if (( bytes > MAX_BYTES )); then
    die "too large to beam ($(human_size "$bytes"), limit $(human_size "$MAX_BYTES"))"
  fi
  classify "$content"
  printf '%s' "$BEAM_PAYLOAD" | qrencode --type ANSIUTF8 --margin 2 --level "$QR_LEVEL" \
    || die "failed to generate QR code"
  printf '\n%s — %s\n' "$BEAM_LABEL" "$(preview_of "${BEAM_DISPLAY:-$BEAM_PAYLOAD}" "$BEAM_KIND")"
}

# Beam Link: start the LAN server and show its URL as a QR in the overlay.
cmd_link() {
  require_qrencode
  have omarchy-shell || die "omarchy-shell not found — Omarchy Beam needs the Omarchy shell to display the overlay."
  have python3 || die "Beam Link needs python3. Install it with: sudo pacman -S python"
  [[ -x "$SERVE_BIN" ]] || die "helper not found or not executable: $SERVE_BIN"

  # Resolve how many entries to share: explicit arg, else a picker prompt.
  local sel
  if [[ -n "${1:-}" ]]; then
    case "$1" in
      current|--current) sel="current" ;;
      all|--all)         sel="500" ;;
      *[!0-9]*)          die "invalid count: $1 (use a number, 'current', or 'all')" ;;
      *)                 sel="$1" ;;
    esac
  else
    sel="$(prompt_count)" || return 0   # cancelled
  fi

  link_stop
  mkdir -p "$LINK_DIR" && chmod 700 "$LINK_DIR" 2>/dev/null

  local ttl="${BEAM_LINK_TTL:-180}"
  local args=(--ttl "$ttl" --url-file "$LINK_URL_FILE" --pid-file "$LINK_PID_FILE")
  if [[ "$sel" == "current" ]]; then args+=(--current); else args+=(--count "$sel"); fi

  # Fully detach so the server outlives this launcher; it self-expires via TTL
  # and is stopped when the overlay closes. Its stderr is kept in a log so a
  # startup failure can be reported instead of vanishing.
  local log="$LINK_DIR/serve.log"
  : >"$log" 2>/dev/null
  if have setsid; then
    setsid "$SERVE_BIN" "${args[@]}" >/dev/null 2>>"$log" </dev/null &
  else
    nohup "$SERVE_BIN" "${args[@]}" >/dev/null 2>>"$log" </dev/null &
  fi
  disown 2>/dev/null || true

  # Wait (up to ~4s) for the server to bind and publish its URL.
  local i
  for (( i = 0; i < 80; i++ )); do
    [[ -s "$LINK_URL_FILE" ]] && break
    sleep 0.05
  done
  if [[ ! -s "$LINK_URL_FILE" ]]; then
    local err; err="$(tail -n 3 "$log" 2>/dev/null | tr '\n' ' ')"
    link_stop
    die "could not start the Beam Link server${err:+ — $err} (run: omarchy-beam --link-doctor)"
  fi

  omarchy-shell shell summon "$PLUGIN_ID" '{}' \
    || { link_stop; die "could not reach the Omarchy shell (is it running?)."; }
}

# Stop a running Beam Link server (called by the overlay when it closes).
cmd_link_stop() { link_stop; }

# Diagnose Beam Link problems: run the server in the foreground so its real
# output (URL or error) is visible, and show this host's addresses.
cmd_link_doctor() {
  printf 'Omarchy Beam %s — Beam Link diagnostics\n\n' "$BEAM_VERSION"
  printf 'serve helper : %s\n' "$SERVE_BIN"
  [[ -e "$SERVE_BIN" ]] && printf '  exists     : yes\n' || printf '  exists     : NO\n'
  [[ -x "$SERVE_BIN" ]] && printf '  executable : yes\n' || printf '  executable : NO (chmod +x it)\n'
  if have python3; then printf 'python3      : %s\n' "$(python3 --version 2>&1)"; else printf 'python3      : NOT FOUND (sudo pacman -S python)\n'; fi
  printf 'runtime dir  : %s\n\n' "$LINK_DIR"

  printf 'Starting the server for 5s (its URL or error follows):\n'
  printf -- '----------------------------------------------------------------\n'
  timeout 5 "$SERVE_BIN" --count 3 --ttl 4 2>&1 | head -30
  printf -- '----------------------------------------------------------------\n\n'

  printf 'This host'\''s IPv4 addresses (the URL host should match one):\n'
  if have ip; then
    ip -4 addr show scope global 2>/dev/null | awk '/inet /{printf "  %s  (%s)\n", $2, $NF}'
  else
    printf '  (the `ip` command is not available)\n'
  fi
}

# Default: toggle the overlay in the running Omarchy shell.
cmd_toggle() {
  # A normal invocation always exits any active link mode so it shows the
  # clipboard, not a stale link.
  link_stop
  require_clipboard
  have omarchy-shell || die "omarchy-shell not found — Omarchy Beam needs the Omarchy shell to display the overlay."

  # If there is nothing to beam, don't flash a full-screen overlay: notify and
  # close any stale overlay that might still be up.
  if [[ "$(clipboard_has_text)" != "1" ]]; then
    notify "Omarchy Beam" "Nothing to Beam"
    omarchy-shell -q shell hide "$PLUGIN_ID" >/dev/null 2>&1
    return 0
  fi
  local content
  content="$(read_clipboard)"
  if [[ -z "${content//[[:space:]]/}" ]]; then
    notify "Omarchy Beam" "Nothing to Beam"
    omarchy-shell -q shell hide "$PLUGIN_ID" >/dev/null 2>&1
    return 0
  fi

  # The overlay reads the clipboard itself (via --emit) when it opens, so no
  # clipboard data is ever passed through the IPC payload / command line.
  omarchy-shell shell toggle "$PLUGIN_ID" '{}' \
    || die "could not reach the Omarchy shell (is it running?)."
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
  case "${1:-}" in
    -h|--help)     cmd_help ;;
    -V|--version)  cmd_version ;;
    --emit)        cmd_emit ;;
    --link)        shift; cmd_link "${1:-}" ;;
    --link-stop)   cmd_link_stop ;;
    --link-doctor) cmd_link_doctor ;;
    -)             cmd_pipe ;;
    "")            cmd_toggle ;;
    *)             die "unknown option: $1 (try --help)" ;;
  esac
}

# Only run when executed directly. When sourced (e.g. by the test suite) the
# functions above are exposed without invoking anything.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
